# Database
DATABASE_URL="postgresql://pms_user:pms_password@localhost:5432/pms_db"

# JWT
JWT_SECRET="change-this-to-a-secure-random-256-bit-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS=7

# App
PORT=3000
NODE_ENV=development

# File uploads
UPLOAD_DEST="./uploads"

# Email — Option A: Company SMTP
# SMTP_HOST="mail.yourcompany.com"
# SMTP_PORT=465
# SMTP_USER="noreply@yourcompany.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM_NAME="PMS"
# SMTP_FROM_EMAIL="noreply@yourcompany.com"

# Email — Option B: Gmail SMTP (requires App Password; 2FA must be on)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM_NAME="PMS"
SMTP_FROM_EMAIL="your-gmail@gmail.com"

# Frontend URL (used in password reset links)
APP_FRONTEND_URL="http://localhost:5173"

# Backend URL (used in email templates for logo and asset URLs)
APP_BACKEND_URL="http://localhost:3000"
